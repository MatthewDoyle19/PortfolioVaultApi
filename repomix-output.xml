            string statusText = setting.IsMaintenance ? "🔴 ENABLED (Surprise Mode Active)" : "🟢 DISABLED (Public)";
            await telegram.SendNotificationAsync($"⚙️ System Update: Maintenance Mode is now {statusText}");

            return Results.Ok(setting);
        });
    }
}
