<!-- =========================================================================
                             GLOBAL & SYSTEM SCREENS
     ========================================================================= -->

<!-- MAINTENANCE SCREEN -->
<div id="maintenance-screen" class="hidden fixed inset-0 z-[100000] bg-[#fdfbf7] flex flex-col items-center justify-center p-6 text-center text-slate-800">
    <div class="absolute inset-0 opacity-20 pointer-events-none" style="background-image: repeating-linear-gradient(transparent, transparent 39px, #cbd5e1 39px, #cbd5e1 40px);"></div>
    <div class="relative z-10 max-w-md flex flex-col items-center gap-6">
        <span onclick="emergencyBypass()" class="text-6xl animate-spin cursor-pointer hover:scale-110 transition-transform" style="animation-duration: 4s;" title="System Core">⚙️</span>
        <h1 class="text-3xl md:text-4xl font-serif font-bold tracking-wide text-slate-900">Vault Under Maintenance</h1>
        <div class="w-16 h-[2px] bg-red-400/50 my-2"></div>
        <p class="text-lg leading-relaxed font-sans text-slate-600 px-4">
            7amodee is currently brewing a magical new feature and a surprise for ZoZo ❤️. inside the Vault... Access is temporarily restricted to the Lead Engineer! 🤫
            <br><br>
            The new ink will dry soon ☕✨
        </p>
        <span class="text-xs tracking-[0.2em] uppercase text-slate-400 font-mono mt-8 cursor-pointer select-none">The Vault Project v2.1.3</span>    
    </div>
</div>

<!-- BACKGROUND GLOW EFFECTS -->
