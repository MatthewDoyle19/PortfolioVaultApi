        <div class="absolute left-0 top-0 bottom-0 w-3 md:w-10 bg-[#3a2e24] border-r border-[#261d15] shadow-[inset_-3px_0_10px_rgba(0,0,0,0.5)] z-20"></div>
        <div class="absolute left-8 md:left-28 top-0 bottom-0 w-[2px] bg-red-400/40 z-10"></div>

        <div class="flex items-center justify-between px-4 md:px-8 py-3 md:py-5 border-b border-slate-300/50 bg-[#fdfbf7]/90 backdrop-blur-md z-30 ml-3 md:ml-10">
            <button onclick="closeDiaryCanvas()" class="text-slate-500 hover:text-slate-800 transition-all flex items-center gap-1 md:gap-2 text-[10px] md:text-xs uppercase tracking-widest font-bold group">
                <svg class="w-4 h-4 md:w-5 md:h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                <span class="hidden sm:inline">Close Book</span>
                <span class="sm:hidden">Close</span>
            </button>
            <div class="flex items-center gap-2 md:gap-4">
                <span id="diary-status" class="text-[9px] md:text-[10px] uppercase tracking-widest text-slate-400 font-mono animate-pulse">Ready</span>
                <button onclick="saveDiary(true)" class="bg-slate-800 hover:bg-black text-[#fdfbf7] px-4 md:px-6 py-2 rounded-full text-[10px] md:text-xs font-bold tracking-widest uppercase transition-all active:scale-95 shadow-md">
                    <span class="hidden sm:inline">Save Ink</span>
                    <span class="sm:hidden">Save</span>
                </button>
            </div>
        </div>

        <div class="flex-grow relative w-full h-full p-4 pl-12 pr-4 md:p-12 md:pl-32 md:pr-12 overflow-y-auto custom-scrollbar z-10" style="background-image: repeating-linear-gradient(transparent, transparent 39px, #cbd5e1 39px, #cbd5e1 40px); background-attachment: local;">
            <textarea id="diary-textarea" dir="auto" oninput="handleDiaryInput()" class="w-full h-full min-h-[500px] bg-transparent text-slate-800 text-lg md:text-2xl leading-[40px] focus:outline-none resize-none placeholder-slate-400 font-serif" placeholder="Dear Diary..."></textarea>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- ☕ DEEP TALKS SIDEBAR MODULE -->
<!-- ========================================== -->

<!-- 1. The Overlay (الخلفية الزجاجية الداكنة) -->
<div id="deep-talks-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[60] hidden opacity-0 transition-opacity duration-300" onclick="window.closeDeepTalks()"></div>

<!-- 2. The Sidebar (اللوحة المنزلقة) -->
<div id="deep-talks-sidebar" class="fixed top-0 right-0 h-full w-full md:w-[400px] bg-slate-900/95 backdrop-blur-2xl border-l border-white/10 z-[70] transform translate-x-full transition-transform duration-300 flex flex-col shadow-2xl">

    <!-- Header (الترويسة) -->
    <div class="flex items-center justify-between p-6 border-b border-white/10 bg-black/20">
        <h2 class="text-xl font-bold text-white flex items-center gap-3">
            <span class="bg-pink-500/20 p-2 rounded-lg">☕</span>
            Deep Talks
        </h2>
        <button onclick="window.closeDeepTalks()" class="text-slate-400 hover:text-pink-400 transition-colors p-2">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
    </div>

    <!-- Content List -->
    <div id="deep-talks-list" class="flex-1 overflow-y-auto p-6 space-y-3 custom-scrollbar">
        <!-- سيتم حقن المحادثات هنا عبر الـ JavaScript باستخدام تصميم الـ Hover الجديد -->
    </div>

    <!-- Input Area (منطقة الإضافة بالتصميم الحديث) -->
    <div class="p-5 border-t border-white/10 bg-black/40 backdrop-blur-md">
        <form id="add-talk-form" class="relative flex items-center w-full">
            <!-- أيقونة تعبيرية داخل المربع -->
            <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none">
                <span class="text-pink-400/70 text-lg">💭</span>
            </div>

            <!-- مربع النص -->
            <input type="text" id="talk-input" placeholder="Type a topic to talk about..." class="w-full bg-white/5 border border-white/10 rounded-2xl py-4 pl-12 pr-28 text-sm text-white placeholder-slate-400 focus:outline-none focus:border-pink-500/50 focus:bg-white/10 transition-all backdrop-blur-md shadow-inner" autocomplete="off" required>

            <!-- زر الإضافة المدمج ككبسولة -->
            <div class="absolute inset-y-1.5 right-1.5 flex items-center">
                <button type="submit" class="h-full bg-gradient-to-r from-pink-600 to-purple-600 hover:from-pink-500 hover:to-purple-500 text-white px-5 rounded-xl text-sm font-bold transition-all active:scale-95 shadow-[0_0_15px_rgba(219,39,119,0.3)] flex items-center gap-2">
                    <span>Add</span>
                    <svg class="w-4 h-4 hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                </button>
            </div>
        </form>
    </div>
</div>

